generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum IncidentStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

// There is no ServiceStatus enum or column: a service's health is derived from
// its open incidents every time it is read (see src/utils/serviceHealth.js), so
// it can never disagree with the incidents it comes from.

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

// Every tenant-owned table below carries an orgId. Queries always filter on it;
// that filter is what keeps one organization's data away from another's.
model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  services    Service[]
  incidents   Incident[]
  invitations Invitation[]
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique // always stored lowercase
  name         String
  passwordHash String
  role         Role         @default(MEMBER)
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdIncidents    Incident[]       @relation("IncidentCreator")
  assignedIncidents   Incident[]       @relation("IncidentAssignee")
  incidentUpdates     IncidentUpdate[]
  timelineEvents      TimelineEvent[]
  invitationsCreated  Invitation[]     @relation("InvitationCreator")
  invitationsAccepted Invitation[]     @relation("InvitationAcceptedBy")

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
}

model Service {
  id           String       @id @default(uuid())
  name         String
  description  String?
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  incidents Incident[] @relation("IncidentToService")

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
}

model Incident {
  id           String         @id @default(uuid())
  title        String
  description  String?
  status       IncidentStatus @default(TRIGGERED)
  severity     Severity
  // Private by default. Only incidents with isPublic = true appear on the
  // public status page or influence the health shown there.
  isPublic     Boolean        @default(false)
  orgId        String
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)

  creatorId  String
  creator    User    @relation("IncidentCreator", fields: [creatorId], references: [id])
  assigneeId String?
  assignee   User?   @relation("IncidentAssignee", fields: [assigneeId], references: [id])

  createdAt      DateTime  @default(now()) // when the incident was triggered
  acknowledgedAt DateTime? // set when TRIGGERED -> ACKNOWLEDGED, cleared when reopened
  resolvedAt     DateTime? // set when RESOLVED, cleared when reopened
  updatedAt      DateTime  @updatedAt

  affectedServices Service[]        @relation("IncidentToService")
  updates          IncidentUpdate[]
  timelineEvents   TimelineEvent[]

  @@index([orgId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([orgId, status])
  @@index([orgId, isPublic, createdAt(sort: Desc)])
  @@index([creatorId])
  @@index([assigneeId])
}

// A message posted on an incident. Public ones are shown on the status page.
model IncidentUpdate {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  message    String   @db.Text
  isPublic   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([incidentId])
  @@index([userId])
}

// One row per change to an incident. Rows are only ever inserted.
model TimelineEvent {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  eventType  String // see src/utils/timelineEvents.js
  metadata   Json? // the details of the change, e.g. { oldStatus, newStatus }
  // Who made the change. Null for system events, for rows that predate actor
  // tracking, and when the user has since been deleted.
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
  @@index([actorId])
}

// A one-time link that lets a person join an organization. Only the SHA-256
// hash of the token is stored, so a database leak does not leak usable links.
// The migration adds CHECK ("role" <> 'ADMIN'): an invitation can never grant ADMIN.
model Invitation {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role         Role
  tokenHash    String       @unique
  expiresAt    DateTime
  usedAt       DateTime? // set atomically when the invitation is accepted
  usedById     String?
  usedBy       User?        @relation("InvitationAcceptedBy", fields: [usedById], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?        @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@index([orgId, createdAt(sort: Desc)])
}
