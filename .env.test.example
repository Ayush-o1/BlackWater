# ─────────────────────────────────────────────────────────────────────────────
# BlackWater — Test Environment Variables
# Copy this file to .env.test and point it at a disposable database.
#   cp .env.test.example .env.test
#
# Integration tests run `prisma migrate deploy` against this database and
# delete all rows between tests. Never point this at a database with data
# you care about.
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://user:password@localhost:5432/blackwater_test?schema=public"
JWT_SECRET="test_only_secret_at_least_32_characters_long"
JWT_EXPIRES_IN=1d
PORT=8001
NODE_ENV="test"
CORS_ORIGIN="http://localhost:5173"
