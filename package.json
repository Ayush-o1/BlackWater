{
  "name": "blackwater",
  "version": "1.0.0",
  "description": "Incident management platform with a public status page",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "prisma:studio": "prisma studio",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "pretest": "npm run test:migrate",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:all-browsers": "ALL_BROWSERS=1 playwright test",
    "smoke": "playwright test -c playwright.smoke.config.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.10.2",
    "socket.io": "^4.8.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@6.0.0": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "prisma@5.22.0": true
  }
}
