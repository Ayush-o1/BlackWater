# ─────────────────────────────────────────────────────────────────────────────
# BlackWater — Environment Variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/blackwater?schema=public"

# JWT signing secret (required)
# Must be a strong random string — minimum 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace_with_a_strong_random_secret_at_least_32_chars"

# JWT token expiry (optional, default: 1d)
JWT_EXPIRES_IN=1d

# Server port (optional, default: 8000)
PORT=8000

# Environment mode (optional, default: development)
NODE_ENV="development"


# Requests allowed per IP per 15 minutes (optional)
# AUTH_RATE_LIMIT covers login, registration and invitation links (default: 20).
# API_RATE_LIMIT covers everything else (default: 300).
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=300

# Number of reverse proxies in front of the app (optional, default: 0)
# Set to 1 behind a single proxy/load balancer so rate limits use each visitor's real IP.
TRUST_PROXY=0
